ARG APP_BASE_IMAGE
FROM ${APP_BASE_IMAGE}

ARG SOURCE_REVISION=unknown
ARG SOURCE_CONTENT_SHA256=unknown
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
      com.oracle.har-analyzer.source-content-sha256=${SOURCE_CONTENT_SHA256} \
      com.oracle.har-analyzer.runtime=combined-api-worker \
      com.oracle.har-analyzer.build-mode=verified-prebuilt

ENV WORKER_CONCURRENCY=1

WORKDIR /app
COPY --chown=10001:10001 backend/dist ./dist
COPY --chown=10001:10001 dist ./public

USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/combinedRuntime.js"]
